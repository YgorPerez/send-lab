node_modules/

# Output
.output
.vercel
.netlify
.wrangler
/dist
/.tanstack

# OS / editor
.DS_Store
Thumbs.db

# Env
.env
.env.*
!.env.example
!.env.test

# Vite
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# TanStack Router generated route tree. Versioned deliberately — `tsr generate`
# reproduces it, but committing it keeps a fresh clone type-checking before the
# first build, exactly as `.svelte-kit/tsconfig.json` used to be regenerated.

# Paraglide JS generated output (reproducible from messages/ + project.inlang/)
/src/lib/paraglide

# SQLite database (local dev data)
*.db
*.db-shm
*.db-wal

# Serena (https://github.com/oraios/serena)
# `.serena/project.yml` IS versioned — it is the shared project configuration. Serena writes its own
# `.serena/.gitignore` covering the symbol cache and local overrides, so those are not repeated here.
#
# Memories are the one deliberate departure from Serena's defaults. Serena can share them across
# sessions and users, but this repo already keeps its curated knowledge in CONTEXT.md and docs/adr/ —
# committing an agent-written store beside those would give the same facts two sources of truth, which
# is what the glossary and ADRs exist to prevent. Serena is pointed at the curated docs through
# `initial_prompt` in project.yml instead.
.serena/memories/

# Impeccable (.claude/skills/impeccable, vendored from upstream; see docs/agents/impeccable.md).
# The engine is a per-platform ~20 MB binary. The launcher downloads the one pinned in
# scripts/VERSION on first run, checks it against scripts/engine-checksums.txt, and caches it in
# ~/.impeccable/bin/, so a copy next to the launcher is never committed.
.claude/skills/impeccable/scripts/bin/
