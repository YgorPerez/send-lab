{
	"name": "send-lab",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"packageManager": "pnpm@11.5.2",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && pnpm run build:sw && pnpm run check:sw",
		"build:sw": "tsx scripts/build-service-worker.ts",
		"preview": "vite preview",
		"paraglide": "tsx scripts/compile-messages.ts",
		"routes": "tsr generate",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write .",
		"lint:hooks": "eslint .",
		"check": "pnpm run paraglide && pnpm run routes && tsgo --noEmit",
		"check:env": "tsx scripts/check-env.ts",
		"check:i18n": "tsx scripts/check-locale-parity.ts",
		"check:routes": "tsx scripts/check-auth-wrapper.ts",
		"check:sw": "tsx scripts/check-service-worker.ts",
		"check:contrast": "tsx scripts/check-contrast.ts",
		"check:hydration": "tsx scripts/check-hydration.ts",
		"check:motion": "tsx scripts/check-motion.ts",
		"doctor": "react-doctor --no-telemetry",
		"fallow": "fallow dead-code",
		"fallow:health": "fallow health",
		"test": "vitest run --project unit",
		"db:push": "drizzle-kit push",
		"db:ddl": "tsx scripts/apply-ddl.ts",
		"verify": "pnpm run lint && pnpm run lint:hooks && pnpm run check && pnpm run check:env && pnpm run check:i18n && pnpm run check:routes && pnpm run doctor && pnpm run fallow && pnpm run test"
	},
	"dependencies": {
		"@base-ui/react": "1.7.0",
		"@libsql/client": "0.17.4",
		"@t3-oss/env-core": "0.13.11",
		"@tanstack/db": "0.8.2",
		"@tanstack/react-db": "0.3.2",
		"@tanstack/react-router": "1.170.29",
		"@tanstack/react-start": "1.168.46",
		"better-auth": "1.6.25",
		"clsx": "2.1.1",
		"drizzle-orm": "0.45.2",
		"lucide-react": "1.31.0",
		"motion": "13.1.0",
		"nitro": "3.0.260610-beta",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"tailwind-merge": "3.6.0",
		"tailwind-variants": "3.3.1",
		"tw-animate-css": "1.4.0",
		"zod": "4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.0",
		"@fontsource-variable/inter": "5.2.8",
		"@fontsource-variable/roboto-mono": "5.2.9",
		"@inlang/paraglide-js": "2.20.1",
		"@inlang/plugin-m-function-matcher": "2.2.9",
		"@inlang/plugin-message-format": "4.4.0",
		"@tailwindcss/vite": "4.3.3",
		"@tanstack/router-cli": "1.167.30",
		"@tanstack/router-plugin": "1.168.32",
		"@types/node": "26.0.0",
		"@types/react": "19.2.7",
		"@types/react-dom": "19.2.4",
		"@typescript-eslint/parser": "8.67.0",
		"@typescript/native-preview": "7.0.0-dev.20260622.1",
		"@vitejs/plugin-react": "6.0.5",
		"drizzle-kit": "0.31.10",
		"eslint": "10.8.1",
		"eslint-plugin-react-hooks": "7.1.1",
		"fallow": "2.101.0",
		"jsdom": "30.0.1",
		"react-doctor": "0.9.12",
		"tailwindcss": "4.3.3",
		"tsx": "4.22.4",
		"typescript": "6.0.3",
		"vite": "8.2.1",
		"vitest": "4.1.10",
		"workbox-build": "7.4.1"
	}
}
